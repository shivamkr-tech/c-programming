// Write a C program to check whether a year is leap year or not.

#include <stdio.h>

int main(){
   int y;
   printf("Enter the year:\n");
   scanf("%d", &y);
   
   if((y%4==0 && y%100!=0)||(y%400==0))
   {
       printf("%d is the Leap Year.",y);
   }
   
   else{
       printf("%d is not a Leap Year.",y);
   }
   
    
    return 0;
}
