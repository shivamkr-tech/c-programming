   float D,x1,x2;

   printf("Enter the cofficient of ax^2+bx+c.\n");
   scanf("%d%d%d",&a,&b,&c);
   
   D=b*b-4*a*c;
   
   if(D>0){
      x1 = (-b + sqrt(D)) / (2*a);
        x2 = (-b - sqrt(D)) / (2*a);
       
       printf("The roots of this quadratic eq %dx^2 + %dx + %d=0 is real roots and the roots.\n" , a,b,c);
       printf("Root 1 : %.2f\n" ,x1);
       printf("Root 2 : %.2f\n" ,x2);
   }
   
   else if(D==0){
       x1=-b / (2*a);
       x2=x1;
       
       printf("The roots of this quadratic eq  %dx^2 + %dx + %d=0 is equal and real roots and the roots.\n" , a,b,c);
